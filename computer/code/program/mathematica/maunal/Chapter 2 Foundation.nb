Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CPHASE", "[", 
    RowBox[{"c_", ",", "t_", ",", "\[Theta]_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"proj0", ",", "proj1", ",", "Irest"}], "}"}], ",", 
     RowBox[{
      RowBox[{"proj0", "=", 
       RowBox[{"KroneckerProduct", "@@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "c"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"KroneckerProduct", "@@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"gate", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], " ", "=", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"gate", "[", "1", "]"}], ",", 
          RowBox[{"gate", "[", "2", "]"}], ",", "...", ",", 
          RowBox[{"gate", "[", "n", "]"}]}], "]"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"proj1", "=", 
       RowBox[{"KroneckerProduct", "@@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "c"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Irest", "=", 
       RowBox[{"KroneckerProduct", "@@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "t"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"Exp", "[", 
                 RowBox[{"I", " ", "\[Theta]"}], "]"}]}], "}"}]}], "}"}], ",", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"proj0", "+", 
       RowBox[{"proj1", ".", "Irest"}]}]}]}], "]"}]}], ";"}]], "Input",Express\
ionUUID->"a7034988-9c7b-41f9-850e-6431294438eb"],

